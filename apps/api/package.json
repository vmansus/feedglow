    "@hono/zod-validator": "^0.4.0",
    "@mozilla/readability": "^0.6.0",
    "@types/sanitize-html": "^2.16.0",
    "ai": "^4.1.0",
    "bcrypt": "^6.0.0",
    "hono": "^4.7.0",
    "iconv-lite": "^0.7.2",
    "jsdom": "^28.0.0",
    "pg": "^8.18.0",
    "playwright": "^1.58.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "eslint": "^9.0.0",
