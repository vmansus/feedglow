# ============ Required ============

# Database
DATABASE_URL=postgres://feedglow:your_password@localhost:5432/feedglow

# Auth
JWT_SECRET=generate-a-random-secret-here

# ============ Optional ============

# Public URLs (for Telegram webhooks, shared feeds, etc.)
# PUBLIC_URL=https://your-feedglow-domain.com
# API_PUBLIC_URL=https://api.your-domain.com
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# CORS (comma-separated origins)
# CORS_ORIGINS=https://your-feedglow-domain.com

# Registration mode: open | invite | closed (default: closed)
# REGISTRATION_MODE=closed

# RSSHub instance (self-hosted recommended)
# RSSHUB_URL=http://localhost:1200

# AI Provider (for summaries, translations, etc.)
# DEEPSEEK_API_KEY=sk-xxx

# Newsletter (Cloudflare Email Workers)
# NEWSLETTER_DOMAIN=mail.your-domain.com
# NEWSLETTER_WEBHOOK_SECRET=generate-a-random-secret

# Encryption secret (defaults to JWT_SECRET if not set)
# ENCRYPTION_SECRET=generate-a-random-secret
