# FeedGlow API Dockerfile
FROM node:22-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Dependencies stage
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile --prod=false

# Build stage
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY . .
RUN pnpm --filter @feedglow/shared build
RUN pnpm --filter @feedglow/api build

# Use pnpm deploy to create a standalone directory with resolved symlinks
RUN pnpm --filter @feedglow/api deploy /app/deployed --prod

# Production stage
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

# Copy built output + pnpm-deployed node_modules (no symlinks)
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/deployed/node_modules ./node_modules

EXPOSE 3001

CMD ["node", "dist/index.js"]
